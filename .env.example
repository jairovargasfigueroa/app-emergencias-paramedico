# Copiar como .env.local (no se versiona) y completar.

# URL del backend vista desde el teléfono: la IP de tu computadora en la red, no "localhost".
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Firebase Realtime Database (configuración de la app web del proyecto de Firebase).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cada cuántos segundos la app envía la posición mientras el paramédico está en servicio (PB-03 R4).
EXPO_PUBLIC_ENVIO_POSICION_SEG=5

# Minutos sin ninguna unidad tras los que una emergencia se marca en tono de aviso en la lista.
EXPO_PUBLIC_MINUTOS_ABANDONO=5

# Centro del mapa mientras no se conoce la posición del teléfono.
# Coordenadas de la ciudad donde opera el servicio, en grados decimales.
EXPO_PUBLIC_MAPA_LATITUD=
EXPO_PUBLIC_MAPA_LONGITUD=

# Solo para el development build. No llevan EXPO_PUBLIC_: las lee app.config.ts.
# Clave de Google Maps para Android.
GOOGLE_MAPS_API_KEY=
# Ruta al google-services.json de la app Android en Firebase (push con FCM), p. ej. ./google-services.json
GOOGLE_SERVICES_JSON=
